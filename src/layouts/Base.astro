---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.scss';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  // For pages search engines shouldn't list, like the 404 page.
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;

// Pages build as privacy.html but are served at /privacy (the .html address
// redirects there), so canonical and og:url name the clean URL.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(path, Astro.site);

// The 1200×630 share image, once public/og.png exists. Until then, the logo
// and Twitter's small card. The build runs from the project root.
const hasShareImage = existsSync(join(process.cwd(), 'public', 'og.png'));
const ogImage = new URL(hasShareImage ? '/og.png' : '/logo-240.png', Astro.site);
const ogImageAlt = 'Skies: city clocks, each under the color of its sky, with the gap from your time.';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#111017" />

    <!--
      Which store leads the install buttons (InstallButtons.astro, Nav.astro).
      Set before the first paint, so nothing moves. Phones and Safari get
      "other": Skies is a desktop extension for Chrome-based browsers and Firefox.
    -->
    <script is:inline>
      (() => {
        const ua = navigator.userAgent;
        const mobile = /Android|iPhone|iPad|iPod|Mobi/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        document.documentElement.dataset.browser = mobile
          ? 'other'
          : /Firefox\//.test(ua)
            ? 'firefox'
            : /Chrome\//.test(ua)
              ? 'chromium'
              : 'other';
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skies" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {
      hasShareImage ? (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogImageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image:alt" content={ogImageAlt} />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Umami Cloud analytics: cookieless. data-domains skips localhost and preview hosts. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="3e06944e-fbbf-41e7-80d0-eaa6a47340d0"
      data-domains="useskies.com"></script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

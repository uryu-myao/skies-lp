---
import '../styles/popup.scss';
import { makeStars, type CardView } from '../lib/tz';

// One city card, marked up like the extension's (src/components/Timezone.tsx)
// and styled by its own Timezone.scss (styles/popup.scss). `badge` is the DST
// badge ("Nov 1 → −14h"), `compact` edit mode's single row, and `converting`
// the converter's state, which hides the stars. The data-field hooks let the
// live demo (PopupDemo.astro) repaint a card in place.
interface Props {
  view: CardView;
  badge?: string;
  compact?: boolean;
  converting?: boolean;
}

const { view, badge = '', compact = false, converting = false } = Astro.props;
const stars = makeStars(view.city);
---

<div
  class:list={['timezone', `timezone--${view.sky}`, { 'timezone--compact': compact, 'timezone--converting': converting }]}
  data-card
>
  <div class="timezone-inner">
    <svg class="timezone-stars" aria-hidden="true">
      {stars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} fill="white" fill-opacity={s.o} />)}
    </svg>
    <div class="timezone-data__location" data-field="city">{view.city}</div>
    <div class="timezone-data__time" data-field="time">{view.time}</div>
    {
      !compact && (
        <div class="timezone-footer">
          <p><span class="timezone-data__relative" data-field="relative">{view.relative}</span><span class="timezone-data__offset" data-field="utc">{view.utc}</span><span class="timezone-data__dst" data-field="badge" hidden={!badge}>{badge}</span></p>
          <p><span class="timezone-data__day-relative" data-field="dayLabel" hidden={!view.dayLabel}>{view.dayLabel}</span><span><span class="timezone-data__week" data-field="week">{view.week}</span><span><span class="timezone-data__date" data-field="date">{view.date}</span><span class="timezone-data__month" data-field="month">{view.month}</span></span></span></p>
        </div>
      )
    }
  </div>
</div>

<style lang="scss">
  // The extension draws stars only at night and not while converting; here
  // they're always in the markup, so a live card can change sky.
  .timezone:not(.timezone--night) .timezone-stars,
  .timezone--converting .timezone-stars {
    display: none;
  }

  // Past the classes' own display (the day note is an inline-block).
  [hidden] {
    display: none !important;
  }

  // An inline <svg> sizes to its box here, as in the extension.
  .timezone-stars {
    max-width: none;
  }
</style>

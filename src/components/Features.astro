---
import SkyCard from './SkyCard.astro';
import { cardView, type City } from '../lib/tz';

const skies = ['Night', 'Dawn', 'Day', 'Twilight'];

// The other visuals are stills of the extension's popup at its own sizes, seen by
// someone in Tokyo. Cards are worked out for a fixed moment, so their skies,
// gaps and dates are the ones the extension shows then.
const TOKYO: City = { city: 'Tokyo', zone: 'Asia/Tokyo', lat: 35.69, lon: 139.69 };
const BOSTON: City = { city: 'Boston', zone: 'America/New_York', lat: 42.36, lon: -71.06 };
const KOLKATA: City = { city: 'Kolkata', zone: 'Asia/Kolkata', lat: 22.57, lon: 88.36 };
const PARIS: City = { city: 'Paris', zone: 'Europe/Paris', lat: 48.86, lon: 2.35 };
const at = (iso: string, ...cities: City[]) => cities.map((c) => cardView(c, TOKYO.zone, new Date(iso)));

// 08:30 on a Wednesday in Tokyo, still Tuesday evening in Boston.
const gaps = at('2026-10-20T23:30:00Z', TOKYO, BOSTON, KOLKATA);
// 23:57 on Oct 23 in Tokyo, nine days before Boston leaves daylight saving
// on Nov 1. The banner and badge are worded as dstCopy.ts words them.
const [dstBoston] = at('2026-10-23T14:57:00Z', BOSTON);
// 23:57 in Tokyo, with the converter dragged to 15:00 that day.
const [converted] = at('2026-10-20T06:00:00Z', BOSTON);
const convertStops = [0, 3, 6, 9, 12, 15, 18, 21, 24];
// Edit mode, also at 23:57 in Tokyo.
const editing = at('2026-10-20T14:57:00Z', TOKYO, PARIS, BOSTON);

// Core Time, 9–18 everywhere, on a Tokyo axis: Singapore is 10–19 there and
// Berlin (summer time) 16–01, so its row wraps past midnight. Everyone
// overlaps 16:00–18:00.
const coreDots = [3, 6, 9, 12, 15, 18, 21];
const coreRows = [
  { city: 'Tokyo', you: true, hours: [[9, 18]] },
  { city: 'Singapore', you: false, hours: [[10, 19]] },
  { city: 'Berlin', you: false, hours: [[0, 1], [16, 24]] },
];
const overlap = { from: 16, to: 18 };
const pct = (h: number) => `${(h / 24) * 100}%`;
---

<section class="features" id="features">
  <div class="container">
    <header class="features__intro">
      <p class="eyebrow">Features</p>
      <h2>Built for working across time zones</h2>
      <p>Everything opens from one click on the toolbar, and nothing gets in the way of reading the time.</p>
    </header>

    <!-- Skies and the DST alert lead: on a three-column screen they share the first row with Gaps. -->
    <div class="features__grid">
      <article class="feature">
        <div class="feature__visual" aria-hidden="true">
          <div class="popup popup--list">
            {gaps.map((view) => <SkyCard view={view} />)}
          </div>
        </div>
        <h3>Gaps, not offsets</h3>
        <p>
          Each city leads with how far it is from you: −13h, +3:30h, or Base. The UTC offset sits beside it as a
          cross-check, and a date that isn't yours says yesterday or tomorrow.
        </p>
      </article>

      <article class="feature">
        <div class="feature__visual feature__visual--skies" aria-hidden="true">
          {
            skies.map((name) => {
              const sky = name.toLowerCase();
              return (
                <span class="sky" style={`--c0:var(--sky-${sky}-0);--c1:var(--sky-${sky}-1);--c2:var(--sky-${sky}-2)`}>
                  {name}
                </span>
              );
            })
          }
        </div>
        <h3>A sky for every city</h3>
        <p>
          Cards take on the color of each city's sky right now — night, dawn, day, or twilight — worked out from where
          the sun actually is, so even the midnight sun looks right.
        </p>
      </article>

      <article class="feature">
        <div class="feature__visual feature__visual--dst" aria-hidden="true">
          <div class="popup popup--list">
            <div class="dst-banner">
              <span class="dst-banner__icon">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <circle cx="7" cy="7" r="5.6" stroke="currentColor" stroke-width="1.3"></circle>
                  <path d="M7 4v3.2l2 1.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <div class="dst-banner__text">
                <p class="dst-banner__headline">In <span class="dst-banner__time">9 days</span> (<span class="dst-banner__time">Nov 1</span>), <span class="dst-banner__city">Boston</span> shifts to <span class="dst-banner__time">UTC−05</span> — your clock doesn’t.</p>
                <p class="dst-banner__detail">Your gap: <span class="dst-banner__time">13 hours</span> → <span class="dst-banner__time">14 hours</span></p>
              </div>
              <span class="dst-banner__close">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              </span>
            </div>
            <SkyCard view={dstBoston} badge="Nov 1 → −14h" />
          </div>
        </div>
        <h3>The clocks change, your gap moves</h3>
        <p>
          Two weeks before a time change, Skies tells you what it does to you: “In 9 days, Boston shifts to UTC−05.
          Your gap: 13 hours → 14 hours.” Including the case where you don't change your clocks at all and your
          colleague does.
        </p>
      </article>

      <article class="feature">
        <div class="feature__visual" aria-hidden="true">
          <div class="popup">
            <div class="core-time">
              <div class="core-time__header">
                <span class="core-time__title">Core time</span>
                <span class="core-time__meta">
                  today · 3 cities
                  <svg class="core-time__chevron" width="10" height="10" viewBox="0 0 10 10" fill="none">
                    <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </div>
              <div class="core-time__band">
                {
                  coreRows.map((row) => (
                    <>
                      <span class:list={['core-time__label', { 'core-time__label--you': row.you }]}>
                        {row.city}
                        {row.you && <span class="core-time__you">You</span>}
                      </span>
                      <span class="core-time__track">
                        {coreDots.map((h) => (
                          <span class:list={['core-time__dot', { hour: h % 6 === 0 }]} style={`left:${pct(h)}`} />
                        ))}
                        {row.hours.map(([from, to]) => (
                          <span class="core-time__segment" style={`left:${pct(from)};width:${pct(to - from)}`} />
                        ))}
                        <span class="core-time__overlap" style={`left:${pct(overlap.from)};width:${pct(overlap.to - overlap.from)}`} />
                      </span>
                    </>
                  ))
                }
                <span></span>
                <span class="core-time__scale">{[0, 6, 12, 18, 24].map((h) => <span>{h}</span>)}</span>
              </div>
              <div class="core-time__conclusion">
                <span class="core-time__headline">Overlap <span class="core-time__range">16:00–18:00</span></span>
              </div>
            </div>
          </div>
        </div>
        <h3>Core Time</h3>
        <p>
          See when everyone's working hours overlap. No overlap today? Skies suggests the closest time. Someone off
          today? It shows when the next overlap is.
        </p>
      </article>

      <article class="feature">
        <div class="feature__visual feature__visual--converter" aria-hidden="true">
          <div class="popup popup--panel">
            <div class="header">
              <span class="header__chip">
                <img src="/favicon.svg" alt="" width="22" height="22" />
                <span class="header__pill">
                  <span class="header__city">Tokyo</span>
                  <span class="header__time">23:57</span>
                  <svg class="header__chevron" width="8" height="8" viewBox="0 0 10 10" fill="none">
                    <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </span>
              <span class="header__btns">
                <span class="header__group">
                  <span class="header__btn header__btn--plus"></span>
                  <span class="header__btn header__btn--convert"></span>
                </span>
                <span class="header__group">
                  <span class="header__btn header__btn--settings"></span>
                </span>
              </span>
            </div>
            <div class="converter">
              <span class="converter__reset">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.2 4.6A4 4 0 1 1 2 6.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                  <path d="M1.8 1.8v3h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="converter__scale">{[0, 6, 12, 18, 24].map((h) => <span>{h}</span>)}</span>
              <span class="converter__track">
                {convertStops.map((_, i) => <span class:list={['converter__dot', { hour: i % 2 === 0 }]} />)}
                <span class="converter__thumb"><span></span><span></span><span></span></span>
              </span>
            </div>
            <div class="popup--list popup--converted">
              <SkyCard view={converted} converting />
            </div>
          </div>
        </div>
        <h3>Time converter</h3>
        <p>
          Drag one slider across 24 hours and every city moves with it. Find a slot that works before you send the
          invite.
        </p>
      </article>

      <article class="feature">
        <div class="feature__visual" aria-hidden="true">
          <div class="popup popup--panel popup--edit">
            <div class="edit-bar">
              <span class="edit-bar__title">Edit list</span>
              <span class="edit-bar__done">Done</span>
            </div>
            <div class="popup--list">
              {
                editing.map((view) => (
                  <div class="edit-row">
                    <span class="edit-row__remove" />
                    <SkyCard view={view} compact />
                    <span class="edit-row__handle">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M2 4h10M2 7h10M2 10h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                      </svg>
                    </span>
                  </div>
                ))
              }
            </div>
            <span class="undo-toast">Removed Berlin <span class="undo-toast__sep">·</span> <span class="undo-toast__undo">Undo</span></span>
          </div>
        </div>
        <h3>Your list, your way</h3>
        <p>
          Add up to 30 cities — search in English, Chinese or Japanese, or by an older name like Bangalore. Give them
          your own names and reorder them by drag or keyboard. Removed one by mistake? Undo.
        </p>
      </article>
    </div>
  </div>
</section>

<style lang="scss">
  .features {
    padding: clamp(40px, 6vw, 72px) 0 clamp(72px, 10vw, 120px);

    &__intro {
      max-width: 620px;
      margin-bottom: 48px;

      h2 {
        margin: 12px 0 14px;
        font-size: clamp(30px, 4.4vw, 44px);
      }

      p:last-child {
        color: var(--color-text-muted);
      }
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
      gap: 20px;
    }
  }

  .feature {
    display: flex;
    flex-direction: column;
    padding: 20px 20px 26px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);

    h3 {
      margin: 22px 4px 8px;
      font-size: 20px;
    }

    p {
      margin: 0 4px;
      font-size: 16px;
      color: var(--color-text-muted);
    }

    // The feature's piece of the popup, with a faint glow behind it in one of
    // the popup's own colors. Nothing clips it, so the glow stays round.
    &__visual {
      --glow: rgba(64, 121, 200, 0.34);
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 256px;

      &::before {
        content: '';
        position: absolute;
        inset: 2% -2%;
        z-index: -1;
        background: radial-gradient(closest-side, var(--glow) 40%, transparent);
        filter: blur(26px);
        pointer-events: none;
      }

      // The four skies side by side, in dawn's mauve.
      &--skies {
        --glow: rgba(185, 148, 195, 0.28);
        flex-direction: row;
        align-items: stretch;
        gap: 6px;
        padding: 24px 20px;
      }

      // The banner's own blue tint. It wraps to more lines than in the 420px
      // popup: five in a three-column card, which still fits, and six on a
      // phone, where the visual grows to hold it.
      &--dst {
        --glow: rgba(0, 170, 255, 0.24);
        height: auto;
        min-height: 256px;
        padding: 22px 0;
      }

      // The converter track's violet.
      &--converter {
        --glow: rgba(109, 104, 145, 0.45);
      }
    }
  }

  // The popup's own type and spacing (the extension's normalize.css sets a
  // 1.15 line height).
  .popup {
    flex: none;
    position: relative;
    width: 100%;
    min-width: 300px;
    color: #fff;
    font-family: var(--font-display);
    line-height: 1.15;

    &--list {
      padding: 0 18px;

      > :global(:last-child) {
        margin-bottom: 0;
      }
    }

    // A piece that includes the popup's chrome (header, edit bar) is shown as
    // a small popup of its own.
    // Its header is 4px narrower a side than the popup's, so the whole 300px
    // header row fits a phone-width card.
    &--panel {
      min-width: 0;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      background: var(--color-popup);
      overflow: hidden;
      box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.6);

      .header {
        padding: 0 14px;
      }
    }

    // The header's 80px padding while the converter is open, then the list's 8px.
    &--converted {
      padding: 8px 18px 14px;
    }

    // Room below the list, so the toast covers only the last row's lower half.
    &--edit {
      padding: 68px 0 34px;
    }
  }

  .sky {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 10px;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--c0), var(--c1) 50%, var(--c2));
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }

  // DstBanner.scss
  .dst-banner {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 8px;
    padding: 10px 8px 10px 12px;
    border: 1px solid rgba(0, 170, 255, 0.1);
    border-radius: 12px;
    background: rgba(0, 170, 255, 0.12);

    &__icon {
      flex: none;
      display: flex;
      margin-top: 1px;
      opacity: 0.7;
    }

    &__text {
      flex: 1;
      min-width: 0;
    }

    &__headline {
      margin: 0 0 6px;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.85);
      text-wrap: wrap;
    }

    &__detail {
      margin: 2px 0 0;
      font-size: 11px;
      font-weight: 400;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.6);
    }

    &__city {
      font-weight: 600;
      color: #fff;
      white-space: nowrap;
    }

    &__time {
      font-weight: 600;
      color: #8fd3ff;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    &__close {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      opacity: 0.6;
    }
  }

  // CoreTimePanel.scss, expanded
  .core-time {
    margin: 0 18px;
    border-radius: 12px;
    background: #202025;
    overflow: hidden;
    box-shadow:
      rgba(255, 255, 255, 0.1) 0 1px 0 0 inset,
      rgba(7, 13, 79, 0.05) 0 0 20px 3px,
      rgba(7, 13, 79, 0.05) 0 0 40px 20px,
      rgba(255, 255, 255, 0.06) 0 0 0 1px inset;

    &__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      min-height: 36px;
      padding: 0 14px;
    }

    &__title {
      font-size: 14px;
      font-weight: 700;
    }

    &__meta {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 500;
      opacity: 0.5;
    }

    &__chevron {
      transform: rotate(180deg);
    }

    &__band {
      display: grid;
      grid-template-columns: minmax(46px, max-content) 1fr;
      align-items: center;
      column-gap: 10px;
      row-gap: 4px;
      padding: 6px 14px 12px;
    }

    &__label {
      display: flex;
      align-items: baseline;
      gap: 4px;
      font-size: 12px;
      font-weight: 600;
      opacity: 0.85;

      &--you {
        color: #9db8ea;
        opacity: 1;
      }
    }

    &__you {
      padding: 2px 4px;
      background: rgba(0, 170, 255, 0.12);
      font-size: 9px;
      font-style: italic;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      opacity: 0.85;
    }

    &__track {
      position: relative;
      height: 10px;
      border-radius: 100vw;
      background: linear-gradient(90deg, #23212a 0%, #6d6891 50%, #23212a 100%);
      overflow: hidden;

      &::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 100vw;
        background: rgba(255, 255, 255, 0.05);
      }
    }

    &__dot {
      position: absolute;
      top: 50%;
      width: 2px;
      height: 2px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.6);
      transform: translate(-50%, -50%);

      &.hour {
        width: 3px;
        height: 3px;
        background: rgba(255, 247, 213, 0.72);
      }
    }

    &__segment {
      position: absolute;
      top: 0;
      bottom: 0;
      background: #5c7cd6;
    }

    &__overlap {
      position: absolute;
      top: -2px;
      bottom: -2px;
      outline: 1.5px solid var(--color-core);
    }

    &__scale {
      display: flex;
      justify-content: space-between;
      margin-top: 2px;
      font-family: var(--font-body);
      font-size: 10px;
      opacity: 0.45;

      span:nth-child(2) {
        padding-left: 9px;
      }

      span:nth-child(3),
      span:nth-child(4) {
        padding-left: 8px;
      }
    }

    &__conclusion {
      padding: 10px 16px 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.075);
    }

    &__headline {
      font-size: 12px;
      font-weight: 600;
    }

    &__range {
      padding-left: 4px;
      color: #9cb2e7;
    }
  }

  // Header.scss, with the converter open
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 60px;
    padding: 0 18px;

    &__chip {
      display: flex;
      align-items: center;
      gap: 10px;

      img {
        border-radius: 50%;
      }
    }

    &__pill {
      display: flex;
      align-items: center;
      height: 32px;
      padding: 0 12px 0 14px;
      border-radius: 100vw;
      background: rgba(0, 170, 255, 0.12);
    }

    &__city {
      padding-right: 5px;
      font-size: 13px;
      font-weight: 700;
    }

    &__time {
      min-width: 38px;
      padding-right: 3px;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-align: right;
      opacity: 0.85;
    }

    &__chevron {
      flex-shrink: 0;
      opacity: 0.7;
    }

    &__btns {
      display: flex;
      gap: 10px;
    }

    &__group {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px;
      border-radius: 100vw;
      background: rgba(0, 170, 255, 0.12);
    }

    // Each icon's drop shadow sits below and to the right of its glyph;
    // --glyph-shift centres the glyph itself.
    &__btn {
      display: block;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background-position: calc(50% + var(--glyph-shift)) calc(50% + var(--glyph-shift));
      background-repeat: no-repeat;

      &--plus {
        --glyph-shift: 0.5px;
        background-size: 15px;
        background-image: url('/icons/icon-plus-dark.svg');
      }

      &--convert {
        --glyph-shift: 0.5px;
        background-color: rgba(255, 255, 255, 0.2);
        background-size: 22px;
        background-image: url('/icons/icon-convert-dark.svg');
      }

      &--settings {
        --glyph-shift: 0.8px;
        background-size: 20px;
        background-image: url('/icons/icon-setting-header.svg');
      }
    }
  }

  .converter {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 40px 18px;
    border-top: 2px solid var(--color-blue);
    background: #202025;

    &__reset {
      position: absolute;
      top: 31px;
      left: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      opacity: 0.7;
    }

    &__scale {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 4px 0 8px;
      font-size: 13px;
      font-weight: 500;
      line-height: 1;
      opacity: 0.5;

      span:nth-child(2),
      span:nth-child(3) {
        padding-left: 4px;
      }
    }

    &__track {
      position: relative;
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 12px;
      padding: 0 10px;
      border-radius: 2px;
      background: linear-gradient(90deg, #23212a 0%, #6d6891 50%, #23212a 100%);

      &::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.05);
      }
    }

    &__dot {
      position: relative;
      z-index: 1;
      width: 2px;
      height: 2px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.6);

      &.hour {
        width: 4px;
        height: 4px;
        background: rgba(255, 247, 213, 0.72);
      }
    }


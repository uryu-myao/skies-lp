---
import SkyCard from './SkyCard.astro';
import '../styles/popup.scss';
import { cardView, type City } from '../lib/tz';
import { coreTimeView } from '../lib/coreTimeCopy';
import { coreTime } from '../lib/extension/coretime';
import { DEFAULT_SETTINGS } from '../lib/extension/model';
import { localHHMM } from '../lib/extension/tz';
import type { Entry } from '../lib/extension/types';

// The extension's popup, live: marked up like its App.tsx and styled by its
// own stylesheets (styles/popup.scss), with its own time, DST and Core Time
// code (lib/extension/). What visitors without JavaScript see: 11:00 on a
// Thursday in Tokyo, which puts London and New York under night skies and
// San Francisco (19:00) under twilight. The script below swaps in the
// visitor's own time zone as Base and keeps everything live.
const SNAPSHOT = new Date('2026-09-24T02:00:00Z');
const REFERENCE = 'Asia/Tokyo';
const CITIES: City[] = [
  { city: 'Tokyo', zone: 'Asia/Tokyo', lat: 35.69, lon: 139.69 },
  { city: 'London', zone: 'Europe/London', lat: 51.51, lon: -0.13 },
  { city: 'New York', zone: 'America/New_York', lat: 40.71, lon: -74.01 },
  { city: 'San Francisco', zone: 'America/Los_Angeles', lat: 37.77, lon: -122.42 },
];
const cards = CITIES.map((c) => cardView(c, REFERENCE, SNAPSHOT));

const entries: Entry[] = CITIES.map((c, i) => ({
  id: String(i),
  timezone: c.zone,
  label: c.city,
  person: null,
  workHours: null,
  workDays: null,
  includeInCoreTime: true,
  pinned: false,
  groups: [],
  order: i,
}));
const settings = { ...DEFAULT_SETTINGS, referenceTimezone: REFERENCE };
const core = coreTimeView(coreTime({ entries, settings, referenceDate: SNAPSHOT }), entries, settings, REFERENCE, false);
const convertStops = [0, 3, 6, 9, 12, 15, 18, 21, 24];
---

<figure class="demo" data-demo>
  <div class="skies-popup demo__popup">
    <div class="app">
      <div class="header" data-header>
        <div class="header-inner">
          <div class="header-tz-chip">
            <span class="header-tz-chip__button">
              <span class="header-tz-chip__logo"></span>
              <span class="header-tz-chip__pill">
                <span class="header-tz-chip__city" data-chip-city>Tokyo</span>
                <span class="header-tz-chip__time" data-chip-time>{localHHMM(REFERENCE, SNAPSHOT)}</span>
                <svg class="header-tz-chip__chevron" width="8" height="8" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </span>
          </div>
          <div class="header-btns">
            <div class="header-btns__inner">
              <div><span class="header-btn header-btn__plus"></span></div>
              <div class="header-convert">
                <button
                  type="button"
                  class="header-btn header-btn__convert"
                  aria-label="Open the time converter"
                  aria-expanded="false"
                  aria-controls="demo-converter"
                  data-convert-toggle></button>
                <div class="header-convert__menu" id="demo-converter" hidden data-convert-menu>
                  <button
                    type="button"
                    class="reset-button header-convert__reset"
                    aria-label="Reset converter to current time"
                    title="Back to now"
                    hidden
                    data-convert-reset>
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2.2 4.6A4 4 0 1 1 2 6.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                      <path d="M1.8 1.8v3h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </button>
                  <div class="header-convert__scale" aria-hidden="true">
                    {[0, 6, 12, 18, 24].map((h) => <span class="header-convert__scale-label">{h}</span>)}
                  </div>
                  <div class="header-convert__track" data-convert-track>
                    {convertStops.map((_, i) => <span class:list={['header-convert__dot', { hour: i % 2 === 0 }]} />)}
                    <span class="header-convert__thumb" data-convert-thumb><span></span><span></span><span></span></span>
                    <input
                      class="demo-range"
                      type="range"
                      min="0"
                      max="48"
                      step="1"
                      value="22"
                      aria-label="Pick a time in your time zone"
                      data-converter
                    />
                  </div>
                </div>
              </div>
            </div>
            <div class="header-btns__inner">
              <div><span class="header-btn header-btn__settings"></span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <section class="dst-banner" aria-label="Time difference change" hidden data-banner>
          <span class="dst-banner__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle cx="7" cy="7" r="5.6" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M7 4v3.2l2 1.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <div class="dst-banner__text">
            <p class="dst-banner__headline" data-banner-headline></p>
            <p class="dst-banner__detail" data-banner-detail></p>
          </div>
          <button type="button" class="dst-banner__close" aria-label="Dismiss" data-banner-close>
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </button>
        </section>
        <div aria-label="City clocks" role="list">
          {cards.map((card) => <div role="listitem"><SkyCard view={card} /></div>)}
        </div>
      </div>

      <div class="core-time-panel" data-core>
        <button type="button" class="core-time-panel__header" aria-expanded="false" data-core-toggle>
          <span class="core-time-panel__title">Core time</span>
          <span class="core-time-panel__meta">
            <span data-core-count>{core.countText}</span>
            <svg class="core-time-panel__chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </button>
        <div class="core-time-panel__band" hidden data-core-band></div>
        <div class="core-time-panel__conclusion-row" data-core-conclusion>
          <div class="core-time-panel__conclusion">
            {
              core.lines.map((line) =>
                line.kind === 'headline' ? (
                  <span class="core-time-panel__headline">
                    {line.text}
                    {line.range && <span class="core-time-panel__headline-range">{line.range}</span>}
                  </span>
                ) : (
                  <span class={line.kind === 'detail' ? 'core-time-panel__detail' : 'core-time-panel__muted-line'}>
                    {line.text}
                  </span>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="demo__caption">
    Live demo: your time zone is Base. Open the converter from the clock button to plan ahead.
  </figcaption>
</figure>

<script>
  import { cardView, type City } from '../lib/tz';
  import { coreTimeView, type ConclusionLine } from '../lib/coreTimeCopy';
  import { coreTime, type CoreTimeResult } from '../lib/extension/coretime';
  import { detectDstTransitions, dismissDstSwitches, pickDstBanner } from '../lib/extension/dst';
  import { dstBadgeDescription, dstBadgeText, dstBannerCopy, type CopyLine } from '../lib/extension/dstCopy';
  import { DEFAULT_SETTINGS } from '../lib/extension/model';
  import { friendlyZoneName, getSystemTimezone, localHHMM, SLOTS_PER_DAY } from '../lib/extension/tz';
  import type { AppSettings, Entry } from '../lib/extension/types';

  // Coordinates as the extension's city search stores them (GeoNames). The
  // visitor's own zone has none, so its sky follows the zone's tzdata location.
  const POOL: City[] = [
    { city: 'London', zone: 'Europe/London', lat: 51.51, lon: -0.13 },
    { city: 'New York', zone: 'America/New_York', lat: 40.71, lon: -74.01 },
    { city: 'Tokyo', zone: 'Asia/Tokyo', lat: 35.69, lon: 139.69 },
    { city: 'San Francisco', zone: 'America/Los_Angeles', lat: 37.77, lon: -122.42 },
    { city: 'Sydney', zone: 'Australia/Sydney', lat: -33.87, lon: 151.21 },
  ];
  const FIELDS = ['city', 'time', 'relative', 'utc', 'dayLabel', 'week', 'date', 'month'] as const;
  const TRACK_DOT_HOURS = [3, 6, 9, 12, 15, 18, 21];

  const $ = <T extends Element>(root: ParentNode, selector: string) => root.querySelector<T>(selector)!;

  function el(tag: string, className: string, text?: string): HTMLElement {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // The banner's wording, cities and times set apart (DstBanner.tsx's Parts).
  function fillParts(target: HTMLElement, parts: CopyLine) {
    target.replaceChildren(
      ...parts.map((part) =>
        part.kind === 'plain' ? document.createTextNode(part.text) : el('span', `dst-banner__${part.kind}`, part.text)
      )
    );
  }

  function nowValue(): number {
    const d = new Date();
    return Math.round((d.getHours() * 60 + d.getMinutes()) / 30);
  }

  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const popup = $<HTMLElement>(root, '.demo__popup');
    const fit = () => popup.style.setProperty('--fit', String(Math.min(1, root.clientWidth / 420)));
    new ResizeObserver(fit).observe(root);

    const header = $<HTMLElement>(root, '[data-header]');
    const app = $<HTMLElement>(root, '.app');
    const toggle = $<HTMLButtonElement>(root, '[data-convert-toggle]');
    const menu = $<HTMLElement>(root, '[data-convert-menu]');
    const reset = $<HTMLButtonElement>(root, '[data-convert-reset]');
    const track = $<HTMLElement>(root, '[data-convert-track]');
    const thumb = $<HTMLElement>(root, '[data-convert-thumb]');
    const slider = $<HTMLInputElement>(root, '[data-converter]');
    const banner = $<HTMLElement>(root, '[data-banner]');
    const coreToggle = $<HTMLButtonElement>(root, '[data-core-toggle]');
    const coreBand = $<HTMLElement>(root, '[data-core-band]');
    const coreCount = $<HTMLElement>(root, '[data-core-count]');
    const coreConclusion = $<HTMLElement>(root, '[data-core-conclusion]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];

    const systemTimezone = getSystemTimezone();
    const cities: City[] = [
      { city: friendlyZoneName(systemTimezone), zone: systemTimezone },
      ...POOL.filter((c) => c.zone !== systemTimezone),
    ].slice(0, cards.length);
    let entries: Entry[] = cities.map((c, i) => ({
      id: String(i),
      timezone: c.zone,
      label: c.city,
      person: null,
      workHours: null,
      workDays: null,
      includeInCoreTime: true,
      pinned: false,
      groups: [],
      order: i,
      lat: c.lat,
      lon: c.lon,
    }));
    let settings: AppSettings = { ...DEFAULT_SETTINGS };
    let converting = false;
    let initialValue = nowValue();
    let coreExpanded = false;
    const badges = new Map<string, { text: string; title: string } | null>();

    const labelOf = (entryId: string) => entries.find((entry) => entry.id === entryId)?.label ?? '';

    // ---- Cards ------------------------------------------------------------
    const converterDate = () => {
      const d = new Date();
      d.setHours(0, Number(slider.value) * 30, 0, 0);
      return d;
    };

    const paintCards = () => {
      const date = converting ? converterDate() : new Date();
      cards.forEach((card, i) => {
        const view = cardView(cities[i], systemTimezone, date);
        card.classList.remove('timezone--night', 'timezone--dawn', 'timezone--day', 'timezone--twilight');
        card.classList.add(`timezone--${view.sky}`);
        card.classList.toggle('timezone--converting', converting);
        for (const field of FIELDS) {
          const node = card.querySelector<HTMLElement>(`[data-field="${field}"]`);
          if (!node || node.textContent === view[field]) continue;
          node.textContent = view[field];
          if (field === 'dayLabel') node.hidden = !view.dayLabel;
        }
        const badge = badges.get(entries[i].id) ?? null;
        const badgeNode = card.querySelector<HTMLElement>('[data-field="badge"]');
        if (badgeNode) {
          badgeNode.textContent = badge?.text ?? '';
          badgeNode.title = badge?.title ?? '';
          badgeNode.hidden = !badge;
        }
      });
      $<HTMLElement>(root, '[data-chip-time]').textContent = localHHMM(systemTimezone, new Date());
    };

    // ---- DST banner and badges (App.tsx) ----------------------------------
    const paintDst = () => {
      const dst = detectDstTransitions({ entries, settings, fromDate: new Date() });
      for (const { entryId, gapChanges } of dst.entries) {
        // The badge looks ahead only: a change already in effect shows on the card itself.
        const next = gapChanges.find((change) => !change.inEffect) ?? null;
        badges.set(entryId, next && { text: dstBadgeText(next), title: dstBadgeDescription(next) });
      }
      const day = pickDstBanner(dst, settings);
      banner.hidden = !day;
      if (!day) return;
      const { headline, detail } = dstBannerCopy(day, labelOf);
      fillParts($(banner, '[data-banner-headline]'), headline);
      fillParts($(banner, '[data-banner-detail]'), detail);
      banner.classList.toggle('dst-banner--in-effect', day.inEffect !== 'none');
      $<HTMLButtonElement>(banner, '[data-banner-close]').onclick = () => {
        settings = dismissDstSwitches(settings, day.switchKeys, new Date());
        paintDst();
      };
    };

    // ---- Core Time (CoreTimePanel.tsx) ------------------------------------
    const toggleCity = (entryId: string) => {
      entries = entries.map((entry) =>
        entry.id === entryId ? { ...entry, includeInCoreTime: !entry.includeInCoreTime } : entry
      );
      paintCore();
    };

    const renderLines = (lines: ConclusionLine[]) => {
      const box = el('div', 'core-time-panel__conclusion');
      for (const line of lines) {
        if (line.kind === 'headline') {
          const headline = el('span', 'core-time-panel__headline', line.text);
          if (line.range) headline.append(' ', el('span', 'core-time-panel__headline-range', line.range));
          box.append(headline);
        } else if (line.kind === 'muted' && line.toggles) {
          const hint = el('button', 'core-time-panel__muted-line core-time-panel__hint-action', line.text);
          (hint as HTMLButtonElement).type = 'button';
          const id = line.toggles;
          hint.addEventListener('click', () => toggleCity(id));
          box.append(hint);
        } else {
          box.append(el('span', line.kind === 'detail' ? 'core-time-panel__detail' : 'core-time-panel__muted-line', line.text));
        }
      }
      coreConclusion.replaceChildren(box);
    };

    const blocksToRanges = (blocks: boolean[]) => {
      const ranges: { start: number; end: number }[] = [];
      let start: number | null = null;
      for (let i = 0; i <= blocks.length; i++) {
        const on = i < blocks.length && blocks[i];
        if (on && start === null) start = i;
        else if (!on && start !== null) {
          ranges.push({ start, end: i });
          start = null;
        }
      }
      return ranges;
    };
    const pct = (slot: number) => `${(slot / SLOTS_PER_DAY) * 100}%`;

    const renderBand = (result: CoreTimeResult, view: ReturnType<typeof coreTimeView>) => {
      const { conclusion } = result;
      const closest = conclusion.status === 'NO_OVERLAP_TODAY' ? conclusion.closest : null;
      const overlapOf = (entryId: string, included: boolean) => {
        if (!included) return [];
        if (conclusion.status === 'PARTIAL_OVERLAP') return conclusion.includedIds.includes(entryId) ? conclusion.overlap : [];
        if (conclusion.status === 'PARTIAL_OFF')
          return conclusion.workingEntryIds.includes(entryId) ? conclusion.workingOverlap : [];
        return result.overlap;
      };

      coreBand.className = `core-time-panel__band${closest ? ' core-time-panel__band--closest' : ''}`;
      const children: HTMLElement[] = [];
      for (const row of result.rows) {
        const role = view.roleOf(row.entryId);
        const label = view.labelOf(row.entryId);
        const rowEl = el(
          'div',
          `core-time-panel__row${row.offToday ? ' core-time-panel__row--off' : ''}${row.included ? '' : ' core-time-panel__row--excluded'}`
        );
        const button = el('button', `core-time-panel__row-label${role ? ' core-time-panel__row-label--baseline' : ''}`);
        (button as HTMLButtonElement).type = 'button';
        button.setAttribute('aria-pressed', String(row.included));
        button.setAttribute('aria-label', `${label}: ${row.included ? 'included in' : 'excluded from'} core time`);
        const name = el('span', 'core-time-panel__row-name', label);
        name.title = label;
        button.append(name);
        if (role) button.append(el('span', 'core-time-panel__row-baseline-tag', role === 'you' ? 'You' : 'Base'));
        if (row.offToday) button.append(el('span', 'core-time-panel__row-off-tag', 'Off'));
        button.addEventListener('click', () => toggleCity(row.entryId));

        const trackEl = el('div', 'core-time-panel__track');
        if (row.offToday) trackEl.title = 'Not a work day';
        for (const hour of TRACK_DOT_HOURS) {
          const dot = el('span', `core-time-panel__dot${hour % 6 === 0 ? ' hour' : ''}`);
          dot.style.left = `${(hour / 24) * 100}%`;
          trackEl.append(dot);
        }
        for (const range of blocksToRanges(row.blocks)) {
          const segment = el('span', 'core-time-panel__segment');
          segment.style.left = pct(range.start);
          segment.style.width = pct(range.end - range.start);
          trackEl.append(segment);
        }
        for (const range of overlapOf(row.entryId, row.included)) {
          const box = el('span', 'core-time-panel__overlap');
          box.style.left = pct(range.startSlot);
          box.style.width = pct(range.endSlot - range.startSlot);
          trackEl.append(box);
        }
        rowEl.append(button, trackEl);
        if (closest) {
          const at = closest.perEntry.find((p) => p.entryId === row.entryId);
          const bottleneck = closest.bottleneckEntryIds.includes(row.entryId);
          rowEl.append(
            el('span', `core-time-panel__row-time${bottleneck ? ' core-time-panel__row-time--bottleneck' : ''}`, at?.localTime ?? '')
          );
        }
        children.push(rowEl);
      }

      const scaleRow = el('div', 'core-time-panel__scale-row');
      const scale = el('div', 'core-time-panel__scale');
      for (const hour of [0, 6, 12, 18, 24]) scale.append(el('span', '', String(hour)));
      scaleRow.append(el('span', ''), scale);
      if (closest) scaleRow.append(el('span', ''));
      children.push(scaleRow);

      if (closest) {
        const layer = el('span', 'core-time-panel__marker-layer');
        layer.style.gridRow = `1 / span ${result.rows.length}`;
        const marker = el('span', 'core-time-panel__marker');
        marker.style.left = pct(closest.slot + 0.5);
        layer.append(marker);
        children.push(layer);
      }
      coreBand.replaceChildren(...children);
    };

    const paintCore = () => {
      const result = coreTime({ entries, settings, referenceDate: new Date() });
      const view = coreTimeView(result, entries, settings, systemTimezone, coreExpanded);
      coreCount.textContent = view.countText;
      root.querySelector('[data-core]')!.classList.toggle('core-time-panel--expanded', coreExpanded);
      coreToggle.setAttribute('aria-expanded', String(coreExpanded));
      coreBand.hidden = !coreExpanded;
      if (coreExpanded) renderBand(result, view);
      renderLines(view.lines);
    };

    coreToggle.addEventListener('click', () => {
      coreExpanded = !coreExpanded;
      paintCore();
    });

    // ---- Converter (Header.tsx) -------------------------------------------
    const paintConverter = () => {
      header.classList.toggle('header--convert-open', converting);
      app.classList.toggle('app--convert-open', converting);
      toggle.classList.toggle('active', converting);
      toggle.setAttribute('aria-expanded', String(converting));
      toggle.setAttribute('aria-label', converting ? 'Close the time converter' : 'Open the time converter');
      menu.hidden = !converting;
      track.style.setProperty('--p', String(Number(slider.value) / 48));
      reset.hidden = Number(slider.value) === initialValue;
      const text = `${converterDate().toTimeString().slice(0, 5)} your time`;
      slider.setAttribute('aria-valuetext', text);
    };

    toggle.addEventListener('click', () => {
      converting = !converting;
      if (converting) {
        initialValue = nowValue();
        slider.value = String(initialValue);
      }
      paintConverter();
      paintCards();
    });
    slider.addEventListener('input', () => {
      paintConverter();
      paintCards();
    });
    slider.addEventListener('pointerdown', () => thumb.classList.add('dragging'));
    window.addEventListener('pointerup', () => thumb.classList.remove('dragging'));
    reset.addEventListener('click', () => {
      initialValue = nowValue();
      slider.value = String(initialValue);
      paintConverter();
      paintCards();
      slider.focus();
    });

    // Live: the clocks every second, DST and Core Time every minute.
    paintDst();
    paintCore();
    paintConverter();
    paintCards();
    setInterval(() => {
      if (!converting) paintCards();
      else $<HTMLElement>(root, '[data-chip-time]').textContent = localHHMM(systemTimezone, new Date());
    }, 1000);
    setInterval(() => {
      paintDst();
      paintCore();
      paintCards();
    }, 60_000);
  }
</script>

<style lang="scss">
  .demo {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;

    // A twilight glow behind the popup
    &::before {
      content: '';
      position: absolute;
      inset: 8% -12% 12%;
      z-index: -1;
      background:
        radial-gradient(closest-side at 35% 40%, rgba(64, 121, 200, 0.45), transparent),
        radial-gradient(closest-side at 70% 70%, rgba(223, 82, 78, 0.22), transparent);
      filter: blur(40px);
    }

    // Always the popup's own 420px, so nothing wraps that doesn't in the
    // extension; narrower screens see it zoomed out to fit (the script sets
    // --fit; the media query is the no-script guess for a 375px phone).
    &__popup {
      width: 420px;
      zoom: var(--fit, 1);

      @media (max-width: 451px) {
        zoom: var(--fit, 0.82);
      }
    }

    &__caption {
      margin-top: 18px;
      font-size: 14px;
      color: var(--color-text-faint);
      text-align: center;
    }
  }

  // The popup window itself: 420 × 540, as the extension sizes it (main.scss).
  .app {
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  // The slider is a real range input laid over the extension's track, so it
  // works by keyboard and screen reader; its own thumb is invisible, the
  // extension's thumb follows it. Wider than the track by 6px a side, so the
  // input's thumb centre runs between the first and last dots (12px in).
  .demo-range {
    position: absolute;
    inset: -5px -6px;
    z-index: 3;
    width: calc(100% + 12px);
    height: 22px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;

    &::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 36px;
      height: 22px;
    }

    &::-moz-range-thumb {
      width: 36px;
      height: 22px;
      border: 0;
    }
  }


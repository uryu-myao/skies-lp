---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Skies" description="This page doesn't exist.">
  <section class="container missing">
    <p class="eyebrow">404</p>
    <h1>This page is in another time zone.</h1>
    <p>We couldn't find what you were looking for.</p>
    <a class="button button--primary" href="/">Back to Skies</a>
  </section>
</Base>

<style>
  .missing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-height: 60vh;
    justify-content: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
  }

  p:not(.eyebrow) {
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }
</style>

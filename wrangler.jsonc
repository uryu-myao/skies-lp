{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard, or Workers Builds
  // refuses to deploy.
  "name": "skies-lp",
  "compatibility_date": "2026-09-24",
  // Workers Builds runs `npx wrangler deploy` with no separate build step, so
  // wrangler builds the site itself before uploading `dist/`.
  "build": { "command": "npm run build" },
  // A static site: no Worker script, Cloudflare serves `dist/` directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "useskies.com", "custom_domain": true }]
}
